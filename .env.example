# Application settings
APP_NAME=Content Intelligence Engine
APP_ENV=development
LOG_LEVEL=INFO
# Copy this file to .env and replace the illustrative values.
# Never commit the .env file.

# PostgreSQL credentials (shared by the development and test containers)
POSTGRES_USER=cie
POSTGRES_PASSWORD=change-me

# Development database (persistent volume)
POSTGRES_DB=cie_dev
POSTGRES_PORT=5432

# Test database (separate container, data discarded when it stops)
POSTGRES_TEST_DB=cie_test
POSTGRES_TEST_PORT=5433

# SQLAlchemy URLs used by the backend; must match the values above
DATABASE_URL=postgresql+psycopg://cie:change-me@localhost:5432/cie_dev
TEST_DATABASE_URL=postgresql+psycopg://cie:change-me@localhost:5433/cie_test

